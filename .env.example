# Copy to .env and fill in. Never commit the real .env.

# Domain pointed at your Hostinger VPS (A record -> VPS IP). Caddy gets the HTTPS certificate.
DOMAIN=registry.example.org

# First Central Secretariat account, created on first start only.
ADMIN_EMAIL=you@example.org
ADMIN_PASSWORD=change-me-to-a-long-password
ADMIN_NAME=Central Secretariat

# Let Country Secretariat staff request accounts from the sign-in page (true/false).
ALLOW_SIGNUP=true

# Date logic (registration windows) follows this time zone.
APP_TIMEZONE=Asia/Manila

# Days a sign-in lasts.
SESSION_DAYS=7
